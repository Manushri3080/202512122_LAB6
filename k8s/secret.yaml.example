apiVersion: v1
kind: Secret
metadata:
  name: mongo-secret
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campusconnect
type: Opaque
stringData:
  USER_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster-url>/userdb?retryWrites=true&w=majority"
  PRODUCT_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster-url>/productdb?retryWrites=true&w=majority"
  ORDER_MONGO_URI: "mongodb+srv://<username>:<password>@<cluster-url>/orderdb?retryWrites=true&w=majority"
